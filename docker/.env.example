# Plantilla de contraseñas para Docker. Copiar a .env (copy .env.example .env) y cambiar
# TODOS los valores. El archivo .env no se sube a Git (.gitignore).
# Si falta .env, docker compose se detiene con un aviso en lugar de usar claves por defecto.

# Contraseña del usuario "odoo" de PostgreSQL. Solo se aplica al crear el volumen pg-datos:
# para cambiarla después, ALTER ROLE dentro de la base o recrear el volumen.
POSTGRES_PASSWORD=cambiar-clave-postgres

# Contraseña maestra de Odoo (admin_passwd), para operaciones de administración de bases.
ODOO_MASTER_PASSWORD=cambiar-clave-maestra

# Contraseña del usuario "admin" para entrar a Odoo. Se aplica al crear la base.
ODOO_ADMIN_PASSWORD=cambiar-clave-admin

# Empresa peruana que se crea en el primer arranque.
EMPRESA_NOMBRE=ABC

# Puertos publicados en este equipo (127.0.0.1).
ODOO_PORT=8071
POSTGRES_PORT=5433
